<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from API 26 on. The launcher masks the foreground to
  whatever shape the device uses - circle, squircle, rounded square - and can
  parallax the two layers independently, so the artwork is split rather than
  shipped as one flat bitmap. The legacy mipmap-*/ic_launcher.png files are
  still needed for API 24-25, which this project's minSdk 24 still includes.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
